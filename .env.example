# The Gmail the agent reads and sends from, with an app password (needs 2-Step Verification).
AGENT_EMAIL=
AGENT_EMAIL_PASSWORD=
# People write to AGENT_EMAIL with +AGENT_ALIAS, e.g. you+uarb@gmail.com
AGENT_ALIAS=uarb
# Optional: understands unusual phrasings of the document type.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAILSCALE_IP=
# Public address of the download-link server (port 8092 through a Cloudflare tunnel).
# Leave empty to send oversize results as several emails instead.
PUBLIC_URL=
